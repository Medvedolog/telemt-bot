#!/bin/sh
# ==============================================================================
# telemt-bot — Post-install script
# ==============================================================================

# ОТКЛЮЧАЕМ СТРОГИЙ РЕЖИМ (Критично для apk на OpenWrt 25+)
set +e

chmod +x /usr/bin/telemt-bot 2>/dev/null || true
chmod +x /etc/init.d/telemt-bot 2>/dev/null || true

# pgrep вернет 1 если пусто. || true спасает скрипт от краша
for p in $(pgrep -f "/usr/bin/telemt-bot" 2>/dev/null || true); do
    kill -KILL "$p" 2>/dev/null || true
done
sleep 1

# ─── Ensure /etc/config/telemt exists ───
UCI_CONF="/etc/config/telemt"

if [ ! -f "$UCI_CONF" ]; then
    logger -t telemt-bot "postinst: UCI config missing — creating minimal skeleton" || true
    cat > "$UCI_CONF" <<'EOF'
config telemt 'general'
	option enabled '0'
	option mode 'tls'
	option domain 'google.com'
	option port '8443'
	option metrics_port '9092'
	option api_port '9091'
	option bot_enabled '0'

config telemt 'network'

EOF
fi

# ─── Ensure 'general' section exists ───
if ! uci -q get telemt.general >/dev/null 2>&1; then
    logger -t telemt-bot "postinst: UCI [general] section missing — adding" || true
    uci set telemt.general='telemt' || true
    uci set telemt.general.enabled='0' || true
    uci set telemt.general.bot_enabled='0' || true
    uci commit telemt 2>/dev/null || true
fi

# ─── Ensure bot_enabled key exists ───
_bot_en=$(uci -q get telemt.general.bot_enabled 2>/dev/null || echo "")
if [ -z "$_bot_en" ]; then
    uci set telemt.general.bot_enabled='0' || true
    uci commit telemt 2>/dev/null || true
fi

# ─── Enable procd service ───
/etc/init.d/telemt-bot enable 2>/dev/null || true

# ─── Auto-start if already configured ───
enabled=$(uci -q get telemt.general.bot_enabled 2>/dev/null || echo "0")
if [ "$enabled" = "1" ]; then
    /etc/init.d/telemt-bot start 2>/dev/null &
fi

exit 0
