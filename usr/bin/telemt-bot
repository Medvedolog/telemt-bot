#!/bin/sh
# ==============================================================================
# Telemt Telegram Bot (ash / OpenWrt native)
# Version: 3.3.20 (Resilient Edge Edition)
# Changelog (since initial shell rewrite):
#   - 3-tier failover: SOCKS -> Direct+DNS -> Direct+HardcodedIP
#   - Fast timeouts (--connect-timeout 3 / --max-time 8) for interactive commands
#   - Emergency Telegram API IP list for DNS Poisoning bypass
#   - Health-check daemon with auto-notifications
#   - UCI flock for safe concurrent access with LuCI
#   - Route tracking & diagnostics in logs
# ==============================================================================

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
BOT_VERSION="3.3.21"

# ──────────────────────────────────────────────
# 0. UCI Config & Auth
# ──────────────────────────────────────────────
TOKEN=$(uci -q get telemt.general.bot_token)
ADMIN_ID=$(uci -q get telemt.general.bot_chat_id)

if [ -z "$TOKEN" ] || [ -z "$ADMIN_ID" ]; then
    logger -t telemt-bot "FATAL: Bot token or Admin Chat ID not set in UCI."
    exit 1
fi

API_URL="https://api.telegram.org/bot${TOKEN}"
OFFSET=0
STATE_FILE="/tmp/telemt_bot_state"
CACHED_PROXY=""
UCI_LOCK="/tmp/telemt_uci.lock"
HEALTH_STATE_FILE="/tmp/telemt_health_state"

# ──────────────────────────────────────────────
# 0a. Timeouts (seconds) — tuned for interactive responsiveness
#     api_poll() uses its own longer timeouts inline
# ──────────────────────────────────────────────
CURL_CONNECT_TIMEOUT=3
CURL_MAX_TIME=8
UCLIENT_TIMEOUT=5
POLL_TIMEOUT=50

# ──────────────────────────────────────────────
# 0b. Emergency Telegram API IPs (DC2 + DC4/5)
#     Used ONLY when system DNS is poisoned and
#     SOCKS proxy is down. Last resort.
# ──────────────────────────────────────────────
TG_EMERGENCY_IPS="149.154.167.220 149.154.167.198 91.108.4.249"

# ──────────────────────────────────────────────
# 0c. Emoji constants
# ──────────────────────────────────────────────
E_OK="\u2705"; E_ERR="\u26d4"; E_INF="\u221e"; E_GLOB="\ud83c\udf10"
E_STAT="\ud83d\udcca"; E_DWN="\u2b07\ufe0f"; E_UP="\u2b06\ufe0f"; E_SHLD="\ud83d\udee1\ufe0f"
E_RTR="\ud83d\udda5\ufe0f"; E_PRX="\ud83d\udd0c"; E_USR="\ud83d\udc65"; E_SET="\u2699\ufe0f"
E_ADD="\u2795"; E_BACK="\u2b05\ufe0f"; E_FILE="\ud83d\udcc4"; E_CSV="\ud83d\udcca"
E_LOG="\ud83d\udccb"; E_RST="\ud83d\udd04"; E_STP="\ud83d\uded1"; E_FRZ="\u2744\ufe0f"
E_DEL="\ud83d\uddd1\ufe0f"; E_CAL="\ud83d\udcc5"; E_KEY="\ud83d\udd11"; E_RGN="\ud83d\udd03"
E_PRF="\ud83d\udc64"; E_WARN="\u26a0\ufe0f"; E_EDIT="\u270f\ufe0f"; E_LINK="\ud83d\udd17"
E_CPU="\u2699\ufe0f"; E_RAM="\ud83d\udcbe"; E_TRAF="\ud83d\udcc8"; E_VER="\ud83d\udce6"
E_OS="\ud83d\udc27"; E_NET="\ud83d\udd17"
E_SCAN="\ud83d\udd0d"; E_PORT="\ud83d\udecf\ufe0f"; E_WGT="\u2696\ufe0f"
E_OFF="\u26aa"; E_PATH="\ud83d\udee3\ufe0f"; E_EXIT="\ud83d\udeaa"

# ==============================================================================
# 1. NETWORK LAYER — 3-TIER FAILOVER
# ==============================================================================

# ─── 0d. Background WAN IP cache ───────────────────
CACHED_WAN_IP=""
WAN_IP_FILE="/tmp/telemt_bot_wan_ip"

refresh_wan_ip() {
    local ip=""
    # Tier 1: via SOCKS (router may have no direct internet)
    if [ -n "$CACHED_PROXY" ] && command -v curl >/dev/null 2>&1; then
        ip=$(curl -s -k --connect-timeout 3 --max-time 5 -x "$CACHED_PROXY" \
            "https://ipv4.internet.yandex.net/api/v0/ip" 2>/dev/null | tr -d ' \n"')
        [ -z "$ip" ] && ip=$(curl -s -k --connect-timeout 3 --max-time 5 -x "$CACHED_PROXY" \
            "https://api.ipify.org" 2>/dev/null | tr -d ' \n"')
    fi
    # Tier 2: direct
    [ -z "$ip" ] && ip=$(uclient-fetch -q -O - --timeout=3 "https://ipv4.internet.yandex.net/api/v0/ip" 2>/dev/null | tr -d ' \n"')
    [ -z "$ip" ] && ip=$(uclient-fetch -q -O - --timeout=3 "https://api.ipify.org" 2>/dev/null | tr -d ' \n"')
    if [ -n "$ip" ]; then
        echo "$ip" > "$WAN_IP_FILE"
    fi
}

# Read WAN IP from cache file (background refresh writes there)
get_wan_ip() {
    [ -f "$WAN_IP_FILE" ] && cat "$WAN_IP_FILE" 2>/dev/null | tr -d ' \n' || echo ""
}

# Compute egress type from UCI upstream config
get_egress_type() {
    local _t _en etype="Direct"
    for _u in $(uci show telemt 2>/dev/null | grep '=upstream' | cut -d. -f2 | cut -d= -f1); do
        _en=$(uci -q get "telemt.${_u}.enabled")
        [ "$_en" = "0" ] && continue
        _t=$(uci -q get "telemt.${_u}.type")
        case "$_t" in socks5) etype="SOCKS5" ;; socks4) etype="SOCKS4" ;; esac
    done
    echo "$etype"
}

# Compute TG Path from UCI
get_tg_path() {
    local mp=$(uci -q get telemt.general.use_middle_proxy)
    [ "$mp" = "1" ] && echo "ME" || echo "Direct-DC"
}

# Fetch all users live stats from API into temp file (graceful: empty file if API off)
# Format per line: username|conns|active_ips|max_ips|total_octets
fetch_users_live() {
    local outfile="$1"
    local api_port=$(uci -q get telemt.general.api_port || echo "9091")
    local raw=$(uclient-fetch -q -O - --timeout=2 "http://127.0.0.1:${api_port}/v1/users" 2>/dev/null)
    : > "$outfile"
    [ -z "$raw" ] && return 1
    echo "$raw" | jsonfilter -e "@.ok" 2>/dev/null | grep -q "true" || return 1
    local i=0
    while true; do
        local u=$(echo "$raw" | jsonfilter -e "@.data[$i].username" 2>/dev/null)
        [ -z "$u" ] && break
        local c=$(echo "$raw" | jsonfilter -e "@.data[$i].current_connections" 2>/dev/null)
        local aips=$(echo "$raw" | jsonfilter -e "@.data[$i].active_unique_ips" 2>/dev/null)
        local mips=$(echo "$raw" | jsonfilter -e "@.data[$i].max_unique_ips" 2>/dev/null)
        local oct=$(echo "$raw" | jsonfilter -e "@.data[$i].total_octets" 2>/dev/null)
        echo "${u}|${c:-0}|${aips:-0}|${mips:-}|${oct:-0}" >> "$outfile"
        i=$((i + 1))
    done
    return 0
}

# Format traffic bytes to human-readable
fmt_traffic() {
    awk "BEGIN { m=$1/1048576; if(m>1024) printf \"%.1f GB\",m/1024; else printf \"%.0f MB\",m }"
}

# ─── 0e. Version cache (read from init.d cache files — never exec telemt binary) ───
CACHED_CORE_VER=""
CACHED_WEB_VER=""

cache_versions() {
    # init.d writes version to /tmp/etc/telemt.version at startup
    CACHED_CORE_VER=$(cat /tmp/etc/telemt.version 2>/dev/null)
    [ -z "$CACHED_CORE_VER" ] && CACHED_CORE_VER=$(cat /tmp/telemt_version 2>/dev/null)
    [ -z "$CACHED_CORE_VER" ] && CACHED_CORE_VER=$(cat /var/run/telemt_version 2>/dev/null)
    [ -z "$CACHED_CORE_VER" ] && CACHED_CORE_VER="Unknown"

    # WebUI version: read once from opkg/apk database (fast, local file I/O only)
    if [ -z "$CACHED_WEB_VER" ] || [ "$CACHED_WEB_VER" = "N/A" ]; then
        CACHED_WEB_VER=$(opkg status luci-app-telemt 2>/dev/null | awk '/^Version:/ {print $2}' | tr -d '\r\n ')
        [ -z "$CACHED_WEB_VER" ] && CACHED_WEB_VER=$(apk info luci-app-telemt 2>/dev/null | awk 'NR==1{print $1}' | sed 's/luci-app-telemt-//' | tr -d '\r\n ')
        [ -z "$CACHED_WEB_VER" ] && CACHED_WEB_VER="N/A"
    fi
}

# ─── 0f. Port cache (read once, avoid uci call per status) ───
CACHED_METRICS_PORT=$(uci -q get telemt.general.metrics_port)
[ -z "$CACHED_METRICS_PORT" ] && CACHED_METRICS_PORT="9092"
CACHED_API_PORT=$(uci -q get telemt.general.api_port)
[ -z "$CACHED_API_PORT" ] && CACHED_API_PORT="9091"

# ─── 1a. SOCKS discovery (cached) ────────────────────
get_active_socks() {
    local p_url=""
    for up in $(uci show telemt | grep '=upstream' | cut -d. -f2 | cut -d= -f1); do
        local en=$(uci -q get "telemt.${up}.enabled" | tr -d '"')
        if [ "$en" = "1" ] || [ "$en" = "true" ] || [ "$en" = "on" ] || [ -z "$en" ]; then
            local type=$(uci -q get "telemt.${up}.type" | tr -d '"')
            if [ "$type" = "socks5" ] || [ "$type" = "socks4" ]; then
                local addr=$(uci -q get "telemt.${up}.address" | tr -d '"' | tr -d ' ')
                if [ -n "$addr" ]; then
                    [ "$type" = "socks5" ] && p_url="socks5h://${addr}"
                    [ "$type" = "socks4" ] && p_url="socks4a://${addr}"
                    break
                fi
            fi
        fi
    done
    echo "$p_url"
}

update_proxy_cache() { CACHED_PROXY=$(get_active_socks); }

# ─── 1b. Tier 1: SOCKS proxy via curl ────────────────
_try_socks() {
    local method="$1" payload="$2"
    [ -z "$CACHED_PROXY" ] && return 1
    command -v curl >/dev/null 2>&1 || return 1

    local res
    res=$(curl -s -k \
        --connect-timeout "$CURL_CONNECT_TIMEOUT" \
        --max-time "$CURL_MAX_TIME" \
        -x "$CACHED_PROXY" \
        -X POST \
        -H "Content-Type: application/json" \
        -d "$payload" \
        "${API_URL}/${method}" 2>/dev/null)

    if echo "$res" | grep -q '"ok":true'; then
        echo "$res"; return 0
    fi
    return 1
}

# ─── 1c. Tier 2: Direct via system DNS (uclient-fetch) ─
_try_direct_dns() {
    local method="$1" payload="$2"
    local res
    res=$(uclient-fetch -q -O - \
        --timeout="$UCLIENT_TIMEOUT" \
        --post-data="$payload" \
        --header="Content-Type: application/json" \
        "${API_URL}/${method}" 2>/dev/null)

    if echo "$res" | grep -q '"ok":true'; then
        echo "$res"; return 0
    fi
    return 1
}

# ─── 1d. Tier 3: Direct via hardcoded IP (--resolve) ─
_try_direct_hardcoded() {
    local method="$1" payload="$2"
    command -v curl >/dev/null 2>&1 || return 1

    local ip res
    for ip in $TG_EMERGENCY_IPS; do
        res=$(curl -s -k \
            --connect-timeout "$CURL_CONNECT_TIMEOUT" \
            --max-time "$CURL_MAX_TIME" \
            --resolve "api.telegram.org:443:${ip}" \
            -X POST \
            -H "Content-Type: application/json" \
            -d "$payload" \
            "${API_URL}/${method}" 2>/dev/null)

        if echo "$res" | grep -q '"ok":true'; then
            logger -t telemt-bot "NET: Tier3 success via emergency IP ${ip}"
            echo "$res"; return 0
        fi
    done
    return 1
}

# ─── 1e. Master request dispatcher ───────────────────
# Returns: JSON response on stdout, exit code 0 on success.
# Side effect: logs which tier succeeded.
LAST_ROUTE="none"

api_request() {
    local method="$1" payload="$2" res=""

    # Tier 1 — SOCKS
    if res=$(_try_socks "$method" "$payload"); then
        [ "$LAST_ROUTE" != "socks" ] && logger -t telemt-bot "NET: Route -> SOCKS (${CACHED_PROXY})"
        LAST_ROUTE="socks"
        echo "$res"; return 0
    fi

    # Tier 2 — Direct + system DNS
    if res=$(_try_direct_dns "$method" "$payload"); then
        [ "$LAST_ROUTE" != "direct" ] && logger -t telemt-bot "NET: Route -> Direct (system DNS)"
        LAST_ROUTE="direct"
        echo "$res"; return 0
    fi

    # Tier 3 — Direct + hardcoded IP (DNS poisoning bypass)
    if res=$(_try_direct_hardcoded "$method" "$payload"); then
        [ "$LAST_ROUTE" != "emergency" ] && logger -t telemt-bot "NET: Route -> EMERGENCY (hardcoded IP)"
        LAST_ROUTE="emergency"
        echo "$res"; return 0
    fi

    logger -t telemt-bot "NET: ALL TIERS FAILED for ${method}"
    LAST_ROUTE="none"
    return 1
}

# ─── 1f. Long-poll specific request (longer timeout) ─
api_poll() {
    local url="${API_URL}/getUpdates?offset=${OFFSET}&timeout=${POLL_TIMEOUT}"
    local poll_connect=5
    local poll_max=$((POLL_TIMEOUT + 10))
    local res=""

    # Tier 1 — SOCKS
    if [ -n "$CACHED_PROXY" ] && command -v curl >/dev/null 2>&1; then
        res=$(curl -s -k \
            --connect-timeout "$poll_connect" \
            --max-time "$poll_max" \
            -x "$CACHED_PROXY" \
            "$url" 2>/dev/null)
        if echo "$res" | grep -q '"ok":true'; then echo "$res"; return 0; fi
    fi

    # Tier 2 — Direct + DNS
    res=$(uclient-fetch -q -O - --timeout="$poll_max" "$url" 2>/dev/null)
    if echo "$res" | grep -q '"ok":true'; then echo "$res"; return 0; fi

    # Tier 3 — Hardcoded IP
    if command -v curl >/dev/null 2>&1; then
        local ip
        for ip in $TG_EMERGENCY_IPS; do
            res=$(curl -s -k \
                --connect-timeout "$poll_connect" \
                --max-time "$poll_max" \
                --resolve "api.telegram.org:443:${ip}" \
                "$url" 2>/dev/null)
            if echo "$res" | grep -q '"ok":true'; then echo "$res"; return 0; fi
        done
    fi
    return 1
}

# ==============================================================================
# 2. MESSAGING LAYER
# ==============================================================================

send_message() {
    local text="$1" keyboard="$2"
    text=$(printf "%s" "$text" | tr -d '\r\t' | sed 's/"/\\"/g' | sed ':a;N;$!ba;s/\n/\\n/g')
    local json="{\"chat_id\":\"${ADMIN_ID}\",\"text\":\"${text}\",\"parse_mode\":\"HTML\""
    [ -n "$keyboard" ] && json="${json},\"reply_markup\":${keyboard}"
    json="${json}}"
    api_request "sendMessage" "$json" >/dev/null
}

# Send message and return message_id for later edit-in-place
send_message_get_id() {
    local text="$1" keyboard="$2"
    text=$(printf "%s" "$text" | tr -d '\r\t' | sed 's/"/\\"/g' | sed ':a;N;$!ba;s/\n/\\n/g')
    local json="{\"chat_id\":\"${ADMIN_ID}\",\"text\":\"${text}\",\"parse_mode\":\"HTML\""
    [ -n "$keyboard" ] && json="${json},\"reply_markup\":${keyboard}"
    json="${json}}"
    local resp=$(api_request "sendMessage" "$json")
    echo "$resp" | jsonfilter -e "@.result.message_id" 2>/dev/null
}

# Edit existing message in place (no new message in chat)
edit_message() {
    local msg_id="$1" text="$2" keyboard="$3"
    [ -z "$msg_id" ] && { send_message "$text" "$keyboard"; return; }
    text=$(printf "%s" "$text" | tr -d '\r\t' | sed 's/"/\\"/g' | sed ':a;N;$!ba;s/\n/\\n/g')
    local json="{\"chat_id\":\"${ADMIN_ID}\",\"message_id\":${msg_id},\"text\":\"${text}\",\"parse_mode\":\"HTML\""
    [ -n "$keyboard" ] && json="${json},\"reply_markup\":${keyboard}"
    json="${json}}"
    api_request "editMessageText" "$json" >/dev/null
}

send_document() {
    local file_path="$1" caption="$2"
    local proxy="$CACHED_PROXY" res=""

    # Try curl (supports both socks and multipart natively)
    if command -v curl >/dev/null 2>&1; then
        local proxy_flag=""
        [ -n "$proxy" ] && proxy_flag="-x $proxy"

        # Tier 1: via SOCKS
        if [ -n "$proxy_flag" ]; then
            res=$(curl -s -k \
                --connect-timeout "$CURL_CONNECT_TIMEOUT" \
                --max-time 30 \
                $proxy_flag \
                -F "chat_id=${ADMIN_ID}" \
                -F "document=@${file_path}" \
                -F "caption=${caption}" \
                -F "parse_mode=HTML" \
                "${API_URL}/sendDocument" 2>/dev/null)
            echo "$res" | grep -q '"ok":true' && return 0
        fi

        # Tier 3: via hardcoded IP (skipping uclient for multipart)
        local ip
        for ip in $TG_EMERGENCY_IPS; do
            res=$(curl -s -k \
                --connect-timeout "$CURL_CONNECT_TIMEOUT" \
                --max-time 30 \
                --resolve "api.telegram.org:443:${ip}" \
                -F "chat_id=${ADMIN_ID}" \
                -F "document=@${file_path}" \
                -F "caption=${caption}" \
                -F "parse_mode=HTML" \
                "${API_URL}/sendDocument" 2>/dev/null)
            echo "$res" | grep -q '"ok":true' && return 0
        done
    fi

    # Tier 2 fallback: uclient-fetch with manual multipart boundary
    local bound="----TelemtBotBoundary" tmp_body="/tmp/tg_upload.tmp"
    printf -- "--%s\r\nContent-Disposition: form-data; name=\"chat_id\"\r\n\r\n%s\r\n" "$bound" "$ADMIN_ID" > "$tmp_body"
    [ -n "$caption" ] && printf -- "--%s\r\nContent-Disposition: form-data; name=\"caption\"\r\n\r\n%s\r\n" "$bound" "$caption" >> "$tmp_body"
    printf -- "--%s\r\nContent-Disposition: form-data; name=\"parse_mode\"\r\n\r\nHTML\r\n" "$bound" >> "$tmp_body"
    printf -- "--%s\r\nContent-Disposition: form-data; name=\"document\"; filename=\"%s\"\r\nContent-Type: text/plain\r\n\r\n" "$bound" "$(basename "$file_path")" >> "$tmp_body"
    cat "$file_path" >> "$tmp_body"
    printf "\r\n--%s--\r\n" "$bound" >> "$tmp_body"
    uclient-fetch -q -O - \
        --timeout="$UCLIENT_TIMEOUT" \
        --post-file="$tmp_body" \
        --header="Content-Type: multipart/form-data; boundary=${bound}" \
        "${API_URL}/sendDocument" >/dev/null 2>&1
    rm -f "$tmp_body"
}

# ==============================================================================
# 3. UCI SAFE ACCESS (flock wrapper)
# ==============================================================================

uci_safe() {
    # Usage: uci_safe set telemt.foo.bar=baz
    # Wraps uci calls with flock to prevent race with LuCI
    local lock_fd=9
    eval "exec ${lock_fd}>${UCI_LOCK}"
    flock -w 3 $lock_fd 2>/dev/null || {
        logger -t telemt-bot "UCI: Lock contention, proceeding without lock"
    }
    uci "$@"
    local rc=$?
    eval "exec ${lock_fd}>&-"
    return $rc
}

uci_safe_commit() {
    local lock_fd=9
    eval "exec ${lock_fd}>${UCI_LOCK}"
    flock -w 3 $lock_fd 2>/dev/null
    uci commit telemt
    local rc=$?
    eval "exec ${lock_fd}>&-"
    return $rc
}

# ==============================================================================
# 4. HEALTH-CHECK DAEMON (background coroutine)
# ==============================================================================
# Runs every 60s. Detects:
#   - telemt proxy process crash
#   - SOCKS upstream unreachability
#   - Route degradation (socks -> direct -> emergency)
# Sends one-shot notification on state CHANGE (no spam).

HEALTH_INTERVAL=60

_health_read_state() {
    cat "$HEALTH_STATE_FILE" 2>/dev/null || echo "unknown|unknown|0"
}

_health_write_state() {
    echo "$1|$2|$(date +%s)" > "$HEALTH_STATE_FILE"
}

_check_proxy_process() {
    pidof telemt >/dev/null 2>&1 && echo "running" || echo "stopped"
}

_check_socks_reachable() {
    [ -z "$CACHED_PROXY" ] && echo "no_proxy" && return
    command -v curl >/dev/null 2>&1 || { echo "no_curl"; return; }

    # Quick test: try to reach TG API through SOCKS with tight timeout
    local res
    res=$(curl -s -k \
        --connect-timeout 3 \
        --max-time 5 \
        -x "$CACHED_PROXY" \
        "${API_URL}/getMe" 2>/dev/null)

    if echo "$res" | grep -q '"ok":true'; then
        echo "reachable"
    else
        echo "unreachable"
    fi
}

health_check_tick() {
    local prev_state=$(_health_read_state)
    local prev_proc=$(echo "$prev_state" | cut -d'|' -f1)
    local prev_socks=$(echo "$prev_state" | cut -d'|' -f2)

    local cur_proc=$(_check_proxy_process)
    local cur_socks=$(_check_socks_reachable)

    # ── Process state change ──
    if [ "$cur_proc" != "$prev_proc" ] && [ "$prev_proc" != "unknown" ]; then
        if [ "$cur_proc" = "stopped" ]; then
            logger -t telemt-bot "HEALTH: Telemt process CRASHED"
            send_message "${E_ERR} <b>ALERT:</b> Telemt proxy process has stopped!\n\nUse /menu to restart."
        elif [ "$cur_proc" = "running" ]; then
            logger -t telemt-bot "HEALTH: Telemt process recovered"
            send_message "${E_OK} <b>Recovered:</b> Telemt proxy is running again."
        fi
    fi

    # ── SOCKS reachability change ──
    if [ "$cur_socks" != "$prev_socks" ] && [ "$prev_socks" != "unknown" ]; then
        if [ "$cur_socks" = "unreachable" ] && [ "$prev_socks" = "reachable" ]; then
            logger -t telemt-bot "HEALTH: SOCKS upstream DOWN"
            send_message "${E_WARN} <b>ALERT:</b> SOCKS upstream is unreachable!\nBot switched to: <b>${LAST_ROUTE}</b> route.\n\nProxy: <code>${CACHED_PROXY}</code>"
        elif [ "$cur_socks" = "reachable" ] && [ "$prev_socks" = "unreachable" ]; then
            logger -t telemt-bot "HEALTH: SOCKS upstream recovered"
            send_message "${E_OK} <b>Recovered:</b> SOCKS upstream is back online.\nProxy: <code>${CACHED_PROXY}</code>"
        fi
    fi

    _health_write_state "$cur_proc" "$cur_socks"
}

start_health_daemon() {
    logger -t telemt-bot "HEALTH: Starting health-check daemon (interval: ${HEALTH_INTERVAL}s)"
    _health_write_state "unknown" "unknown"
    local tick_count=0
    while true; do
        sleep "$HEALTH_INTERVAL"
        update_proxy_cache
        health_check_tick
        tick_count=$((tick_count + 1))
        # Refresh WAN IP every ~5 minutes (5 ticks × 60s)
        if [ $((tick_count % 5)) -eq 0 ]; then
            refresh_wan_ip
        fi
        # Refresh version cache every ~30 minutes (30 ticks)
        if [ $((tick_count % 30)) -eq 0 ]; then
            cache_versions
        fi
    done &
    HEALTH_PID=$!
    logger -t telemt-bot "HEALTH: Daemon PID=${HEALTH_PID}"
}

# ==============================================================================
# 5. COMMAND HANDLER (business logic — from v7.4 + improvements)
# ==============================================================================

handle_command() {
    local cmd="$1"

    # ── State machine: interactive text input ──
    if [ -f "$STATE_FILE" ]; then
        if echo "$cmd" | grep -qE '^(cmd_|user_|up_|mp_|/|\[)'; then
            rm -f "$STATE_FILE"
        else
            local state=$(cat "$STATE_FILE"); rm -f "$STATE_FILE"
            local action=$(echo "$state" | cut -d'_' -f1)
            local tgt=$(echo "$state" | cut -d'_' -f2-)
            case "$action" in
                rename)
                    local new_name=$(echo "$cmd" | tr -d ' \r\n\t')
                    if echo "$new_name" | grep -q '[^a-zA-Z0-9_]' || [ -z "$new_name" ] || [ ${#new_name} -gt 15 ]; then
                        send_message "${E_ERR} Invalid name! Use 1-15 letters, numbers or underscores."; return; fi
                    if [ "$(uci -q get "telemt.${new_name}")" = "user" ]; then
                        send_message "${E_ERR} User <b>${new_name}</b> already exists!"; return; fi
                    uci_safe set "telemt.${new_name}=user"
                    for field in secret data_quota max_unique_ips expire_date disabled max_tcp_conns ad_tag; do
                        local val=$(uci -q get "telemt.${tgt}.${field}")
                        [ -n "$val" ] && uci_safe set "telemt.${new_name}.${field}=${val}"
                    done
                    uci_safe delete "telemt.${tgt}"; uci_safe_commit
                    send_message "${E_OK} User renamed! (Press Apply)"
                    handle_command "user_manage_${new_name}"; return ;;
                quota)
                    local qv=$(echo "$cmd" | tr -d ' \r\n\t' | tr ',' '.')
                    if [ "$qv" = "0" ]; then
                        uci_safe delete "telemt.${tgt}.data_quota" 2>/dev/null
                    elif echo "$qv" | grep -qE '^[0-9]+(\.[0-9]+)?$'; then
                        uci_safe set "telemt.${tgt}.data_quota=${qv}"
                    else
                        send_message "${E_ERR} Invalid quota! Enter a number in GB (e.g. 5 or 1.5), or 0 for unlimited."
                        handle_command "user_manage_${tgt}"; return
                    fi
                    uci_safe_commit; send_message "${E_OK} Quota updated! (Press Apply)"; handle_command "user_manage_${tgt}"; return ;;
                ips)
                    local iv=$(echo "$cmd" | tr -d ' \r\n\t')
                    if [ "$iv" = "0" ]; then
                        uci_safe delete "telemt.${tgt}.max_unique_ips" 2>/dev/null
                    elif echo "$iv" | grep -qE '^[0-9]+$' && [ "$iv" -gt 0 ] 2>/dev/null && [ "$iv" -le 1000 ] 2>/dev/null; then
                        uci_safe set "telemt.${tgt}.max_unique_ips=${iv}"
                    else
                        send_message "${E_ERR} Invalid! Enter a number 1-1000, or 0 for unlimited."
                        handle_command "user_manage_${tgt}"; return
                    fi
                    uci_safe_commit; send_message "${E_OK} Max IPs updated! (Press Apply)"; handle_command "user_manage_${tgt}"; return ;;
                expiry)
                    local ev=$(echo "$cmd" | tr -d '\r\t')
                    if [ "$ev" = "0" ]; then
                        uci_safe delete "telemt.${tgt}.expire_date" 2>/dev/null
                    elif echo "$ev" | grep -qE '^[0-9]{2}\.[0-9]{2}\.[0-9]{4} [0-9]{2}:[0-9]{2}$'; then
                        uci_safe set "telemt.${tgt}.expire_date=${ev}"
                    else
                        send_message "${E_ERR} Invalid format! Use: DD.MM.YYYY HH:MM (e.g. 31.12.2026 23:59), or 0 to clear."
                        handle_command "user_manage_${tgt}"; return
                    fi
                    uci_safe_commit; send_message "${E_OK} Expiry updated! (Press Apply)"; handle_command "user_manage_${tgt}"; return ;;
                upedit)
                    local new_addr=$(echo "$cmd" | tr -d ' \r\n\t')
                    # Sanitize: strip quotes, backslashes, semicolons
                    new_addr=$(echo "$new_addr" | tr -d ';"'"'"'\\')
                    if echo "$new_addr" | grep -qE '^[a-zA-Z0-9._-]+:[0-9]+$'; then
                        uci_safe set "telemt.${tgt}.address=${new_addr}"; uci_safe_commit
                        send_message "${E_OK} Upstream address updated! (Press Apply)"
                    else send_message "${E_ERR} Invalid! Use: IP:PORT or hostname:PORT (e.g. 192.168.1.1:1080)."; fi
                    handle_command "up_manage_${tgt}"; return ;;
                upweight)
                    local w=$(echo "$cmd" | tr -d ' \r\n\t')
                    if echo "$w" | grep -qE '^[0-9]+$' && [ "$w" -gt 0 ] 2>/dev/null && [ "$w" -le 10000 ] 2>/dev/null; then
                        uci_safe set "telemt.${tgt}.weight=${w}"; uci_safe_commit
                        send_message "${E_OK} Weight set to ${w}!"
                    else send_message "${E_ERR} Invalid weight! Enter 1-10000."; fi
                    handle_command "up_manage_${tgt}"; return ;;
                upalias)
                    # Strip HTML tags, quotes, control chars; max 20 chars
                    local al=$(echo "$cmd" | tr -d '\r\n\t' | sed 's/<[^>]*>//g' | tr -d ';"'"'"'\\<>' | cut -c1-20)
                    if [ "$al" = "." ] || [ -z "$al" ]; then
                        uci_safe delete "telemt.${tgt}.alias" 2>/dev/null
                        send_message "${E_OK} Name cleared."
                    elif echo "$al" | grep -qE '^[a-zA-Z0-9 _.:-]+$'; then
                        uci_safe set "telemt.${tgt}.alias=${al}"; send_message "${E_OK} Name: ${al}"
                    else
                        send_message "${E_ERR} Invalid name! Use letters, numbers, spaces, dots, dashes."
                    fi
                    uci_safe_commit; handle_command "up_manage_${tgt}"; return ;;
            esac
        fi
    fi

    case "$cmd" in

    # ── Main menu ──
    "/start"|"/menu")
        local kb="{\"inline_keyboard\":[[{\"text\":\"${E_USR} Users\",\"callback_data\":\"cmd_users\"},{\"text\":\"${E_GLOB} Upstreams\",\"callback_data\":\"cmd_upstreams\"}],[{\"text\":\"${E_STAT} Status\",\"callback_data\":\"cmd_status\"},{\"text\":\"${E_SHLD} Middle Proxy\",\"callback_data\":\"cmd_middle_proxy\"}],[{\"text\":\"${E_SCAN} Runtime Info\",\"callback_data\":\"cmd_runtime_info\"},{\"text\":\"${E_RST} Restart Proxy\",\"callback_data\":\"cmd_restart\"}],[{\"text\":\"${E_STP} Stop Proxy\",\"callback_data\":\"cmd_stop\"}]]}"
        local host_name=$(cat /proc/sys/kernel/hostname 2>/dev/null || echo "Router")
        send_message "<b>Telemt Proxy Manager [${host_name}]</b>\nv${BOT_VERSION} | Egress: <b>$(get_egress_type)</b> | TG: <b>$(get_tg_path)</b>\nSelect an action:" "$kb"
        ;;

    # ── System status (fast path — uses cached WAN IP and versions) ──
    "cmd_status"|"/status")
        local uptime_sys=$(awk '{print int($1/86400)"d "int(($1%86400)/3600)"h "int(($1%3600)/60)"m"}' /proc/uptime)
        local pid=""
        for p in $(pidof telemt 2>/dev/null); do
            if [ "$(cat /proc/$p/comm 2>/dev/null)" = "telemt" ]; then pid="$p"; break; fi
        done
        local p_status="STOPPED"; local s_icon="${E_ERR}"
        if [ -n "$pid" ]; then p_status="RUNNING (PID: $pid)"; s_icon="${E_OK}"; fi

        local host_name=$(cat /proc/sys/kernel/hostname 2>/dev/null || echo "Router")
        local os_ver=$(awk -F"'" '/DISTRIB_DESCRIPTION/ {print $2}' /etc/openwrt_release 2>/dev/null)
        [ -z "$os_ver" ] && os_ver="OpenWrt"

        # Use cached versions (refreshed at startup + hourly by health daemon)
        local core_ver="$CACHED_CORE_VER"; [ -z "$core_ver" ] && core_ver="Unknown"
        local web_ver="$CACHED_WEB_VER"; [ -z "$web_ver" ] && web_ver="N/A"

        local proxy_str="$CACHED_PROXY"; local proxy_info="DIRECT"
        [ -n "$proxy_str" ] && proxy_info="SOCKS (${proxy_str})"

        # Use cached WAN IP (refreshed in background by health daemon)
        local wan_ip="$(get_wan_ip)"; [ -z "$wan_ip" ] && wan_ip="Detecting..."

        local lan_ip=$(ip -4 addr show br-lan 2>/dev/null | awk '/inet / {split($2, a, "/"); print a[1]; exit}')
        local ts_ip=$(ip -4 addr show tailscale0 2>/dev/null | awk '/inet / {split($2, a, "/"); print a[1]; exit}')
        local zt_ip=$(ip -4 addr show 2>/dev/null | awk '/inet / && / zt/ {split($2, a, "/"); print a[1]; exit}')

        local ip_str=""
        [ -n "$lan_ip" ] && ip_str="<b>LAN:</b> ${lan_ip} "
        [ -n "$ts_ip" ] && ip_str="${ip_str}| <b>TS:</b> ${ts_ip} "
        [ -n "$zt_ip" ] && ip_str="${ip_str}| <b>ZT:</b> ${zt_ip} "

        local loadavg=$(cat /proc/loadavg | awk '{print $1", "$2", "$3}')
        local free_ram=$(awk '/MemAvailable/{a=$2} /MemFree/{f=$2} /Buffers/{b=$2} /^Cached/{c=$2} END{if(a){print int(a/1024)}else{print int((f+b+c)/1024)}}' /proc/meminfo)

        local stat_out=""

        if [ -n "$pid" ]; then
            local proc_ram=$(awk '/VmRSS/ {print int($2/1024)}' /proc/$pid/status 2>/dev/null)
            [ -z "$proc_ram" ] && proc_ram="0"

            local r_live=$(uclient-fetch -q -O - --timeout=1 "http://127.0.0.1:${CACHED_METRICS_PORT}/metrics" 2>/dev/null)
            local acc_stats=$(cat /tmp/telemt_stats.txt 2>/dev/null)

            local awk_script='
                BEGIN { tx_live=0; rx_live=0; act=0; dp=0; rej=0; tx_acc=0; rx_acc=0; upt=0; up_ok=0; up_fail=0 }
                /^LIVE_MARKER/ { mode=1; next }
                /^ACC_MARKER/ { mode=2; next }
                /telemt_user_octets_to_client/ { if(mode==1) tx_live+=$2 }
                /telemt_user_octets_from_client/ { if(mode==1) rx_live+=$2 }
                /telemt_user_connections_current/ { if(mode==1 && ($2+0)>0) act++ }
                /telemt_desync_total/ { if(mode==1) dp=$2 }
                /telemt_connections_bad_total/ { if(mode==1) rej=$2 }
                /telemt_upstream_connect_success_total/ { if(mode==1) up_ok=$2 }
                /telemt_upstream_connect_fail_total/ { if(mode==1) up_fail=$2 }
                /telemt_uptime_seconds/ { if(mode==1) upt=$2 }
                { if (mode==2 && NF==3 && !match($0, /^telemt/)) { tx_acc+=$2; rx_acc+=$3 } }
                END {
                    tot_tx_m = (tx_live + tx_acc) / 1048576; tot_rx_m = (rx_live + rx_acc) / 1048576;
                    if(tot_tx_m > 1024) { tx_s = sprintf("%.2f GB", tot_tx_m/1024) } else { tx_s = sprintf("%.2f MB", tot_tx_m) }
                    if(tot_rx_m > 1024) { rx_s = sprintf("%.2f GB", tot_rx_m/1024) } else { rx_s = sprintf("%.2f MB", tot_rx_m) }
                    upt_d = int(upt/86400); upt_h = int((upt%86400)/3600); upt_m = int((upt%3600)/60);
                    printf "%s|%s|%d|%d|%dd %dh %dm|%d|%d|%d", tx_s, rx_s, act, dp, upt_d, upt_h, upt_m, rej, up_ok, up_fail
                }'
            local parsed=$(printf "LIVE_MARKER\n%s\nACC_MARKER\n%s" "${r_live}" "${acc_stats}" | awk "$awk_script")

            local s_dl_tot=$(echo "$parsed"|cut -d'|' -f1)
            local s_ul_tot=$(echo "$parsed"|cut -d'|' -f2)
            local s_act=$(echo "$parsed"|cut -d'|' -f3)
            local s_dpi=$(echo "$parsed"|cut -d'|' -f4)
            local s_upt=$(echo "$parsed"|cut -d'|' -f5)
            local s_rej=$(echo "$parsed"|cut -d'|' -f6)
            local s_upok=$(echo "$parsed"|cut -d'|' -f7)
            local s_upfail=$(echo "$parsed"|cut -d'|' -f8)

            local total_cfg_u=$(uci show telemt | grep -c '=user')
            local frozen_u=$(uci show telemt | grep '\.disabled=' | grep -iE '1|on|true' | wc -l)
            local active_u=$((total_cfg_u - frozen_u))

            # Compute TG Path and Egress from UCI
            local uci_mp=$(uci -q get telemt.general.use_middle_proxy)
            local tg_path="Direct-DC"
            [ "$uci_mp" = "1" ] && tg_path="ME"

            local egress_type="Direct"
            local up_total=0 up_healthy=0
            for _u in $(uci show telemt 2>/dev/null | grep '=upstream' | cut -d. -f2 | cut -d= -f1); do
                local _en=$(uci -q get "telemt.${_u}.enabled")
                [ "$_en" = "0" ] && continue
                up_total=$((up_total + 1))
                local _t=$(uci -q get "telemt.${_u}.type")
                case "$_t" in socks5) egress_type="SOCKS5" ;; socks4) egress_type="SOCKS4" ;; esac
                up_healthy=$((up_healthy + 1))
            done
            [ "$up_total" -eq 0 ] && egress_type="Direct"

            # Port status
            local proxy_port=$(uci -q get telemt.general.port || echo "8443")
            local port_open="closed"
            if iptables-save 2>/dev/null | grep -qiE "dport.*${proxy_port}.*accept" || \
               nft list ruleset 2>/dev/null | grep -qiE "dport.*${proxy_port}.*accept"; then
                port_open="open"
            fi
            local port_icon="${E_ERR}"; [ "$port_open" = "open" ] && port_icon="${E_OK}"

            stat_out="\n\n${E_RTR} <b>Router Uptime:</b> ${uptime_sys}\n${E_PRX} <b>Proxy Uptime:</b> ${s_upt}"
            stat_out="${stat_out}\n${E_PATH} <b>TG Path:</b> ${tg_path} | <b>Egress:</b> ${egress_type}"
            [ "$up_total" -gt 0 ] && stat_out="${stat_out}\n${E_GLOB} <b>Upstream:</b> ${up_healthy}/${up_total} (ok: ${s_upok}, fail: ${s_upfail})"
            stat_out="${stat_out}\n${E_PORT} <b>Port:</b> ${proxy_port} (${port_open})"
            stat_out="${stat_out}\n\n${E_CPU} <b>CPU Load (1/5/15m):</b> ${loadavg}\n${E_RAM} <b>RAM (Free / Telemt):</b> ${free_ram} MB / ${proc_ram} MB"
            stat_out="${stat_out}\n\n${E_TRAF} <b>Total Traffic:</b>\n${E_DWN} DL: ${s_dl_tot} | ${E_UP} UL: ${s_ul_tot}"
            stat_out="${stat_out}\n${E_USR} <b>Users Online:</b> ${s_act} / ${active_u} active"
            stat_out="${stat_out}\n${E_SCAN} <b>DPI Tamper:</b> ${s_dpi} | <b>Rejected:</b> ${s_rej}"
        else
            stat_out="\n\n${E_RTR} <b>Router Uptime:</b> ${uptime_sys}\n${E_PRX} <b>Proxy Uptime:</b> 0d 0h 0m"
        fi

        local route_icon="${E_OK}"
        [ "$LAST_ROUTE" = "direct" ] && route_icon="${E_WARN}"
        [ "$LAST_ROUTE" = "emergency" ] && route_icon="${E_ERR}"
        [ "$LAST_ROUTE" = "none" ] && route_icon="${E_ERR}"

        local out="${E_STAT} <b>System Status [${host_name}]</b>\n\n${s_icon} <b>Service:</b> ${p_status}\n${E_OS} <b>OS:</b> ${os_ver}\n${E_VER} <b>Core:</b> ${core_ver} | <b>UI:</b> ${web_ver}\n${E_GLOB} <b>WAN IP:</b> ${wan_ip}\n${E_SHLD} <b>Bot Route:</b> ${route_icon} ${LAST_ROUTE} (${proxy_info})"
        [ -n "$ip_str" ] && out="${out}\n${E_NET} ${ip_str}"
        out="${out}${stat_out}"

        local kb="{\"inline_keyboard\":[[{\"text\":\"${E_FILE} Get TOML\",\"callback_data\":\"cmd_get_toml\"},{\"text\":\"${E_LOG} Logs\",\"callback_data\":\"cmd_log\"}],[{\"text\":\"${E_RST} Refresh\",\"callback_data\":\"cmd_status\"},{\"text\":\"${E_BACK} Menu\",\"callback_data\":\"/menu\"}]]}"
        if [ -n "$CALLBACK_MSG_ID" ]; then
            edit_message "$CALLBACK_MSG_ID" "$out" "$kb"
        else
            send_message "$out" "$kb"
        fi
        ;;

    # ── Middle Proxy ──
    "cmd_middle_proxy")
        local mp=$(uci -q get telemt.general.use_middle_proxy | awk '{print tolower($1)}')
        local st="${E_ERR} DISABLED"; local t_btn="${E_OK} Enable"
        if [ "$mp" = "1" ] || [ "$mp" = "true" ] || [ "$mp" = "on" ]; then st="${E_OK} ENABLED"; t_btn="${E_ERR} Disable"; fi
        local out="${E_SHLD} <b>Telegram Middle Proxy</b>\n\n<b>Status:</b> ${st}\n\n<i>Note: Toggling this enables/disables Middle Proxy routing AND STUN probing simultaneously. Press Apply to restart proxy.</i>"
        local kb="{\"inline_keyboard\":[[{\"text\":\"${t_btn}\",\"callback_data\":\"mp_toggle\"}],[{\"text\":\"${E_RST} Apply\",\"callback_data\":\"cmd_restart_stay_mp\"}],[{\"text\":\"${E_BACK} Back\",\"callback_data\":\"/menu\"}]]}"
        send_message "$out" "$kb"
        ;;

    "mp_toggle")
        local mp=$(uci -q get telemt.general.use_middle_proxy | awk '{print tolower($1)}')
        if [ "$mp" = "1" ] || [ "$mp" = "true" ] || [ "$mp" = "on" ]; then
            uci_safe set telemt.general.use_middle_proxy='0'; uci_safe set telemt.network.stun_tcp_fallback='0'
        else
            uci_safe set telemt.general.use_middle_proxy='1'; uci_safe set telemt.network.stun_tcp_fallback='1'
        fi
        uci_safe_commit; handle_command "cmd_middle_proxy"
        ;;

    # ── Users list ──
    "cmd_users"|"/users")
        local user_live_file=$(mktemp /tmp/tbot_users.XXXXXX)
        fetch_users_live "$user_live_file"

        local u_online="" u_offline="" u_frozen=""
        local kb_on="" kb_off="" kb_frz=""
        local n_on=0 n_off=0 n_frz=0

        for user in $(uci show telemt | grep '=user' | cut -d. -f2 | cut -d= -f1); do
            local en=$(uci -q get "telemt.${user}.enabled")
            [ "$en" = "0" ] && {
                n_frz=$((n_frz + 1))
                u_frozen="${u_frozen}${E_FRZ} <b>${user}</b> [paused]\n"
                kb_frz="${kb_frz}{\"text\":\"${E_FRZ} ${user}\",\"callback_data\":\"user_manage_${user}\"},"
                continue
            }

            local conns=0 ips=0 octets=0
            local line=$(grep "^${user}|" "$user_live_file" 2>/dev/null)
            if [ -n "$line" ]; then
                conns=$(echo "$line" | cut -d'|' -f2)
                ips=$(echo "$line" | cut -d'|' -f3)
                octets=$(echo "$line" | cut -d'|' -f5)
            fi
            local traf=$(fmt_traffic "${octets:-0}")
            local ip_str=""; [ "${ips:-0}" -gt 0 ] 2>/dev/null && ip_str=", ${ips} IP"

            if [ "${conns:-0}" -gt 0 ] 2>/dev/null; then
                n_on=$((n_on + 1))
                u_online="${u_online}${E_OK} <b>${user}</b> (${conns} conn${ip_str}) | ${traf}\n"
                kb_on="${kb_on}{\"text\":\"${E_OK} ${user}\",\"callback_data\":\"user_manage_${user}\"},"
            else
                n_off=$((n_off + 1))
                u_offline="${u_offline}${E_OFF} ${user} | ${traf}\n"
                kb_off="${kb_off}{\"text\":\"${E_OFF} ${user}\",\"callback_data\":\"user_manage_${user}\"},"
            fi
        done
        rm -f "$user_live_file"

        local total=$((n_on + n_off + n_frz))
        local u_list="${E_USR} <b>Users (${n_on} online / ${total} total):</b>\n\n"
        [ -n "$u_online" ] && u_list="${u_list}${u_online}\n"
        [ -n "$u_offline" ] && u_list="${u_list}${u_offline}\n"
        [ -n "$u_frozen" ] && u_list="${u_list}${u_frozen}"
        [ "$total" -eq 0 ] && u_list="${E_USR} No users configured."

        # Build keyboard: 2 buttons per row
        local all_btns="${kb_on}${kb_off}${kb_frz}"
        all_btns=$(echo "$all_btns" | sed 's/,$//')
        local kb_rows="" btn_buf="" btn_count=0
        local IFS_OLD="$IFS"; IFS=","
        for btn in $all_btns; do
            btn_count=$((btn_count + 1))
            btn_buf="${btn_buf}${btn},"
            if [ "$btn_count" -ge 2 ]; then
                btn_buf=$(echo "$btn_buf" | sed 's/,$//')
                [ -n "$kb_rows" ] && kb_rows="${kb_rows},"
                kb_rows="${kb_rows}[${btn_buf}]"
                btn_buf="" btn_count=0
            fi
        done
        IFS="$IFS_OLD"
        if [ -n "$btn_buf" ]; then
            btn_buf=$(echo "$btn_buf" | sed 's/,$//')
            [ -n "$kb_rows" ] && kb_rows="${kb_rows},"
            kb_rows="${kb_rows}[${btn_buf}]"
        fi
        [ -n "$kb_rows" ] && kb_rows="${kb_rows},"
        local kb="{\"inline_keyboard\":[${kb_rows}[{\"text\":\"${E_ADD} Add User\",\"callback_data\":\"cmd_add_user\"},{\"text\":\"${E_CSV} Get CSV\",\"callback_data\":\"cmd_get_csv\"}],[{\"text\":\"${E_BACK} Menu\",\"callback_data\":\"/menu\"}]]}"
        send_message "$u_list" "$kb"
        ;;

    "cmd_get_csv")
        send_message "Generating users.csv..."
        local csv="/tmp/telemt_users.csv"
        echo "username,secret,max_tcp_conns,max_unique_ips,data_quota,expire_date" > "$csv"
        for u in $(uci show telemt | grep '=user' | cut -d. -f2 | cut -d= -f1); do
            printf "%s,%s,%s,%s,%s,%s\n" "$u" \
                "$(uci -q get telemt.$u.secret)" \
                "$(uci -q get telemt.$u.max_tcp_conns)" \
                "$(uci -q get telemt.$u.max_unique_ips)" \
                "$(uci -q get telemt.$u.data_quota)" \
                "$(uci -q get telemt.$u.expire_date)" >> "$csv"
        done
        send_document "$csv" "Backup of your users list (CSV format)"; rm -f "$csv"
        ;;

    # ── Upstreams ──
    "cmd_upstreams"|"/upstreams")
        local up_list="${E_GLOB} <b>Upstream Proxies:</b>\n\n"
        local kb_buttons="" ups_found=0 is_first=1
        for up in $(uci show telemt | grep '=upstream' | cut -d. -f2 | cut -d= -f1); do
            ups_found=$((ups_found + 1))
            local type=$(uci -q get "telemt.${up}.type" || echo "direct")
            local addr=$(uci -q get "telemt.${up}.address" | tr -d '"' || echo "-")
            local alias=$(uci -q get "telemt.${up}.alias" | tr -d '"')
            local weight=$(uci -q get "telemt.${up}.weight" || echo "10")
            local en=$(uci -q get "telemt.${up}.enabled" | awk '{print tolower($1)}'); [ -z "$en" ] && en="1"
            local icon="${E_OK}"
            [ "$en" = "0" ] || [ "$en" = "false" ] || [ "$en" = "off" ] && icon="${E_FRZ}"
            local label="${type}"
            [ -n "$alias" ] && label="${alias} (${type})"
            [ "$type" = "direct" ] && addr="local"
            up_list="${up_list}${icon} <b>#${ups_found}:</b> ${label}\n<code>${addr}</code> w:${weight}\n\n"
            [ "$is_first" = "1" ] && is_first=0 || kb_buttons="${kb_buttons},"
            local btn_label="${type}"
            [ -n "$alias" ] && btn_label="${alias}"
            kb_buttons="${kb_buttons}[{\"text\":\"${E_SET} ${btn_label}\",\"callback_data\":\"up_manage_${up}\"}]"
        done
        [ "$ups_found" -eq 0 ] && up_list="${E_GLOB} No upstreams configured. Telemt uses Direct."
        local kb="{\"inline_keyboard\":[${kb_buttons}"
        [ "$is_first" = "0" ] && kb="${kb},"
        kb="${kb}[{\"text\":\"${E_ADD} Add Proxy\",\"callback_data\":\"cmd_up_add\"},{\"text\":\"${E_ERR} Disable All\",\"callback_data\":\"cmd_up_disable_all\"}],[{\"text\":\"${E_BACK} Menu\",\"callback_data\":\"/menu\"}]]}"
        send_message "$up_list" "$kb"
        ;;

    "cmd_up_disable_all")
        for up in $(uci show telemt | grep '=upstream' | cut -d. -f2 | cut -d= -f1); do
            uci_safe set "telemt.${up}.enabled=0"
        done
        uci_safe_commit; /etc/init.d/telemt restart; handle_command "cmd_upstreams"
        ;;

    # Upstream creation: step 1 — choose type
    "cmd_up_add")
        local kb="{\"inline_keyboard\":[[{\"text\":\"SOCKS5\",\"callback_data\":\"up_create_socks5\"},{\"text\":\"SOCKS4\",\"callback_data\":\"up_create_socks4\"},{\"text\":\"Direct\",\"callback_data\":\"up_create_direct\"}],[{\"text\":\"${E_BACK} Cancel\",\"callback_data\":\"cmd_upstreams\"}]]}"
        send_message "${E_ADD} <b>Add Upstream Proxy</b>\n\nChoose proxy type:" "$kb"
        ;;

    # Upstream creation: step 2 — create with chosen type
    up_create_direct)
        local n="up_$(awk 'BEGIN{srand(); printf "%04x", rand()*65535}')"
        uci_safe set "telemt.${n}=upstream"
        uci_safe set "telemt.${n}.type=direct"
        uci_safe set "telemt.${n}.weight=10"
        uci_safe set "telemt.${n}.enabled=1"
        uci_safe_commit
        send_message "${E_OK} Direct upstream created."
        handle_command "up_manage_${n}"
        ;;

    up_create_socks4|up_create_socks5)
        local stype="${cmd#up_create_}"
        local n="up_$(awk 'BEGIN{srand(); printf "%04x", rand()*65535}')"
        uci_safe set "telemt.${n}=upstream"
        uci_safe set "telemt.${n}.type=${stype}"
        uci_safe set "telemt.${n}.address=127.0.0.1:1080"
        uci_safe set "telemt.${n}.weight=10"
        uci_safe set "telemt.${n}.enabled=0"
        uci_safe_commit
        echo "upedit_${n}" > "$STATE_FILE"
        send_message "${E_EDIT} Created ${stype} upstream.\nEnter proxy address (<code>IP:PORT</code>):"
        ;;

    up_manage_*)
        local u="${cmd#up_manage_}"
        [ "$(uci -q get "telemt.${u}")" != "upstream" ] && return
        local t=$(uci -q get "telemt.${u}.type" || echo "socks5")
        local a=$(uci -q get "telemt.${u}.address" || echo "-")
        local w=$(uci -q get "telemt.${u}.weight" || echo "10")
        local al=$(uci -q get "telemt.${u}.alias" || echo "")
        local en=$(uci -q get "telemt.${u}.enabled" | awk '{print tolower($1)}'); [ -z "$en" ] && en="1"
        local st="${E_OK} ENABLED"; local t_btn="${E_FRZ} Freeze"
        if [ "$en" = "0" ] || [ "$en" = "false" ] || [ "$en" = "off" ]; then
            st="${E_FRZ} FROZEN"; t_btn="${E_OK} Enable"; fi
        local name_str=""; [ -n "$al" ] && name_str="\n<b>Name:</b> ${al}"
        local out="${E_GLOB} <b>Upstream Proxy Settings</b>\n\n<b>Type:</b> ${t}${name_str}\n<b>Address:</b> <code>${a}</code>\n<b>Weight:</b> ${w}\n<b>Status:</b> ${st}\n\n<i>Use Apply to activate changes.</i>"
        local kb="{\"inline_keyboard\":[[{\"text\":\"${t_btn}\",\"callback_data\":\"up_toggle_${u}\"},{\"text\":\"${E_EDIT} Edit Addr\",\"callback_data\":\"up_edit_${u}\"}],[{\"text\":\"${E_EDIT} Type\",\"callback_data\":\"up_chtype_${u}\"},{\"text\":\"${E_WGT} Weight\",\"callback_data\":\"up_chweight_${u}\"},{\"text\":\"${E_EDIT} Name\",\"callback_data\":\"up_chalias_${u}\"}],[{\"text\":\"${E_DEL} Delete\",\"callback_data\":\"up_del_confirm_${u}\"},{\"text\":\"${E_RST} Apply\",\"callback_data\":\"cmd_restart_stay_up_${u}\"}],[{\"text\":\"${E_BACK} Back\",\"callback_data\":\"cmd_upstreams\"}]]}"
        send_message "$out" "$kb"
        ;;

    up_toggle_*)
        local u="${cmd#up_toggle_}"
        local cur=$(uci -q get "telemt.${u}.enabled" | awk '{print tolower($1)}'); [ -z "$cur" ] && cur="1"
        if [ "$cur" = "1" ] || [ "$cur" = "on" ] || [ "$cur" = "true" ]; then
            uci_safe set "telemt.${u}.enabled=0"
        else uci_safe set "telemt.${u}.enabled=1"; fi
        uci_safe_commit; handle_command "up_manage_${u}"
        ;;

    up_edit_*)
        echo "upedit_${cmd#up_edit_}" > "$STATE_FILE"
        send_message "${E_EDIT} Enter new proxy address (<code>IP:PORT</code>):"
        ;;

    up_chtype_*)
        local u="${cmd#up_chtype_}"
        local kb="{\"inline_keyboard\":[[{\"text\":\"SOCKS5\",\"callback_data\":\"up_settype_socks5_${u}\"},{\"text\":\"SOCKS4\",\"callback_data\":\"up_settype_socks4_${u}\"},{\"text\":\"Direct\",\"callback_data\":\"up_settype_direct_${u}\"}],[{\"text\":\"${E_BACK} Cancel\",\"callback_data\":\"up_manage_${u}\"}]]}"
        send_message "Select new proxy type:" "$kb"
        ;;

    up_settype_*)
        local rest="${cmd#up_settype_}"
        local newtype="${rest%%_*}"
        local u="${rest#*_}"
        uci_safe set "telemt.${u}.type=${newtype}"
        [ "$newtype" = "direct" ] && uci_safe delete "telemt.${u}.address" 2>/dev/null
        uci_safe_commit; handle_command "up_manage_${u}"
        ;;

    up_chweight_*)
        echo "upweight_${cmd#up_chweight_}" > "$STATE_FILE"
        send_message "${E_WGT} Enter weight (number, e.g. 10):"
        ;;

    up_chalias_*)
        echo "upalias_${cmd#up_chalias_}" > "$STATE_FILE"
        send_message "${E_EDIT} Enter upstream name (or send . to clear):"
        ;;

    up_del_confirm_*)
        local u="${cmd#up_del_confirm_}"
        local kb="{\"inline_keyboard\":[[{\"text\":\"${E_DEL} YES, DELETE\",\"callback_data\":\"up_del_do_${u}\"}],[{\"text\":\"CANCEL\",\"callback_data\":\"up_manage_${u}\"}]]}"
        send_message "${E_ERR} Are you sure?" "$kb"
        ;;

    up_del_do_*)
        uci_safe delete "telemt.${cmd#up_del_do_}"
        uci_safe_commit; /etc/init.d/telemt restart; handle_command "cmd_upstreams"
        ;;

    # ── Logs & config ──
    "cmd_log")
        logread | grep -i 'telemt' | tail -n 100 > /tmp/telemt_syslog.txt
        send_document "/tmp/telemt_syslog.txt" "Logs"; rm -f /tmp/telemt_syslog.txt
        ;;
    "cmd_get_toml") send_document "/var/etc/telemt.toml" "Config" ;;

    # ── Runtime Info (human-readable diagnostics) ──
    "cmd_runtime_info")
        local api_port=$(uci -q get telemt.general.api_port || echo "9091")
        local m_port=$(uci -q get telemt.general.metrics_port || echo "9092")
        local out="${E_SCAN} <b>Runtime Info</b>\n"

        # Proxy health from Prometheus
        local prom=$(uclient-fetch -q -O - --timeout=2 "http://127.0.0.1:${m_port}/metrics" 2>/dev/null)
        if [ -n "$prom" ]; then
            local upt=$(echo "$prom" | awk '/^telemt_uptime_seconds /{print $2}')
            local conn=$(echo "$prom" | awk '/^telemt_connections_total /{print $2}')
            local rej=$(echo "$prom" | awk '/^telemt_connections_bad_total /{print $2}')
            local dpi=$(echo "$prom" | awk '/^telemt_desync_total /{print $2}')
            local up_ok=$(echo "$prom" | awk '/^telemt_upstream_connect_success_total /{print $2}')
            local up_fail=$(echo "$prom" | awk '/^telemt_upstream_connect_fail_total /{print $2}')
            local up_att=$(echo "$prom" | awk '/^telemt_upstream_connect_attempt_total /{print $2}')
            local hs_to=$(echo "$prom" | awk '/^telemt_handshake_timeouts_total /{print $2}')

            local u_d=0 u_h=0 u_m=0
            if [ -n "$upt" ]; then
                u_d=$(awk "BEGIN{print int($upt/86400)}")
                u_h=$(awk "BEGIN{print int(($upt%86400)/3600)}")
                u_m=$(awk "BEGIN{print int(($upt%3600)/60)}")
            fi
            local rate="100%"
            [ "${up_att:-0}" -gt 0 ] 2>/dev/null && rate=$(awk "BEGIN{printf \"%.0f%%\", ${up_ok:-0}/${up_att}*100}")

            out="${out}\n<b>--- Proxy Health ---</b>"
            out="${out}\nUptime: ${u_d}d ${u_h}h ${u_m}m"
            out="${out}\nConnections: ${conn:-0}"
            out="${out}\nRejected: ${rej:-0}"
            out="${out}\nHandshake TO: ${hs_to:-0}"
            out="${out}\nDPI Tamper: ${dpi:-0}"
            out="${out}\n\n<b>--- Upstream ---</b>"
            out="${out}\nAttempts: ${up_att:-0}"
            out="${out}\nSuccess: ${up_ok:-0} | Fails: ${up_fail:-0}"
            out="${out}\nRate: ${rate}"
        else
            out="${out}\n<i>Prometheus unavailable</i>"
        fi

        # Config summary
        out="${out}\n\n<b>--- Config ---</b>"
        out="${out}\nME: $(get_tg_path) | Egress: $(get_egress_type)"
        local proxy_port=$(uci -q get telemt.general.port || echo "8443")
        out="${out}\nPort: ${proxy_port}"

        # ME quality from API (graceful)
        local api_me=$(uclient-fetch -q -O - --timeout=2 "http://127.0.0.1:${api_port}/v1/stats/minimal/all" 2>/dev/null)
        if [ -n "$api_me" ] && echo "$api_me" | jsonfilter -e "@.ok" 2>/dev/null | grep -q "true"; then
            local me_en=$(echo "$api_me" | jsonfilter -e "@.data.data.me_writers.middle_proxy_enabled" 2>/dev/null)
            if [ "$me_en" = "true" ]; then
                local alive=$(echo "$api_me" | jsonfilter -e "@.data.data.me_writers.summary.alive_writers" 2>/dev/null)
                local req=$(echo "$api_me" | jsonfilter -e "@.data.data.me_writers.summary.required_writers" 2>/dev/null)
                local cov=$(echo "$api_me" | jsonfilter -e "@.data.data.me_writers.summary.coverage_pct" 2>/dev/null)
                out="${out}\n\n<b>--- ME Pool ---</b>"
                out="${out}\nWriters: ${alive:-0}/${req:-0}"
                out="${out}\nCoverage: ${cov:-0}%"
            fi
        fi

        # Upstream quality from API
        local api_up=$(uclient-fetch -q -O - --timeout=2 "http://127.0.0.1:${api_port}/v1/stats/upstreams" 2>/dev/null)
        if [ -n "$api_up" ] && echo "$api_up" | jsonfilter -e "@.ok" 2>/dev/null | grep -q "true"; then
            local i=0
            local has_ups=0
            while true; do
                local addr=$(echo "$api_up" | jsonfilter -e "@.data.upstreams[$i].address" 2>/dev/null)
                [ -z "$addr" ] && break
                if [ "$has_ups" = "0" ]; then
                    out="${out}\n\n<b>--- Upstreams (API) ---</b>"
                    has_ups=1
                fi
                local hlthy=$(echo "$api_up" | jsonfilter -e "@.data.upstreams[$i].healthy" 2>/dev/null)
                local fails=$(echo "$api_up" | jsonfilter -e "@.data.upstreams[$i].fails" 2>/dev/null)
                local lat=$(echo "$api_up" | jsonfilter -e "@.data.upstreams[$i].effective_latency_ms" 2>/dev/null)
                local st_icon="${E_OK}"; [ "$hlthy" != "true" ] && st_icon="${E_ERR}"
                out="${out}\n${st_icon} ${addr} | fails:${fails:-0} | ${lat:-?}ms"
                i=$((i + 1))
            done
        fi

        local kb="{\"inline_keyboard\":[[{\"text\":\"${E_RST} Refresh\",\"callback_data\":\"cmd_runtime_info\"},{\"text\":\"${E_BACK} Menu\",\"callback_data\":\"/menu\"}]]}"
        if [ -n "$CALLBACK_MSG_ID" ]; then
            edit_message "$CALLBACK_MSG_ID" "$out" "$kb"
        else
            send_message "$out" "$kb"
        fi
        ;;

    # ── Stop / Restart ──
    "cmd_stop")
        uci_safe set telemt.general.enabled='0'; uci_safe_commit
        /etc/init.d/telemt stop; sleep 1
        local kb="{\"inline_keyboard\":[[{\"text\":\"${E_BACK} Menu\",\"callback_data\":\"/menu\"}]]}"
        send_message "<b>${E_STP} STOPPED</b>" "$kb"
        ;;
    "cmd_restart")
        uci_safe set telemt.general.enabled='1'; uci_safe_commit
        /etc/init.d/telemt restart; sleep 2
        local kb="{\"inline_keyboard\":[[{\"text\":\"${E_BACK} Menu\",\"callback_data\":\"/menu\"}]]}"
        send_message "<b>${E_OK} RESTARTED</b>" "$kb"
        ;;

    cmd_restart_stay_mp)
        uci_safe_commit; /etc/init.d/telemt restart; sleep 1
        send_message "${E_OK} Applied (restart)!"; handle_command "cmd_middle_proxy"
        ;;
    cmd_restart_stay_user_*|cmd_apply_stay_user_*)
        local u="${cmd#cmd_restart_stay_user_}"; u="${u#cmd_apply_stay_user_}"
        uci_safe_commit; /etc/init.d/telemt reload 2>/dev/null; sleep 1
        send_message "${E_OK} Applied (hot-reload)!"; handle_command "user_manage_${u}"
        ;;
    cmd_restart_stay_up_*)
        local u="${cmd#cmd_restart_stay_up_}"
        uci_safe_commit; /etc/init.d/telemt restart; sleep 1
        send_message "${E_OK} Applied (restart)!"; handle_command "up_manage_${u}"
        ;;

    # ── User management ──
    user_manage_*)
        local tgt="${cmd#user_manage_}"
        [ "$(uci -q get "telemt.${tgt}")" != "user" ] && return
        local sec=$(uci -q get "telemt.${tgt}.secret" | tr -d '"')
        local q=$(uci -q get "telemt.${tgt}.data_quota" | tr -d '"')
        [ -n "$q" ] && [ "$q" != "unlimited" ] && q="${q} GB" || q="${E_INF}"
        local max_ips=$(uci -q get "telemt.${tgt}.max_unique_ips" | tr -d '"'); [ -z "$max_ips" ] && max_ips="${E_INF}"
        local e=$(uci -q get "telemt.${tgt}.expire_date" | tr -d '"'); [ -z "$e" ] && e="${E_INF}"

        local en=$(uci -q get "telemt.${tgt}.enabled")
        local fr_t="${E_FRZ} Freeze"
        local is_frozen=0
        if [ "$en" = "0" ]; then is_frozen=1; fr_t="${E_OK} Unfreeze"; fi

        # Fetch live stats from API (graceful: works without API too)
        local conns=0 active_ips=0 octets=0 link=""
        local r_usr=$(uclient-fetch -q -O - --timeout=1 "http://127.0.0.1:${CACHED_API_PORT}/v1/users/${tgt}" 2>/dev/null)
        if [ -n "$r_usr" ] && echo "$r_usr" | jsonfilter -e "@.ok" 2>/dev/null | grep -q "true"; then
            conns=$(echo "$r_usr" | jsonfilter -e "@.data.current_connections" 2>/dev/null)
            active_ips=$(echo "$r_usr" | jsonfilter -e "@.data.active_unique_ips" 2>/dev/null)
            octets=$(echo "$r_usr" | jsonfilter -e "@.data.total_octets" 2>/dev/null)
            link=$(echo "$r_usr" | jsonfilter -e "@.data.links.tls[0]" 2>/dev/null)
            [ -z "$conns" ] && conns=0
            [ -z "$active_ips" ] && active_ips=0
            [ -z "$octets" ] && octets=0
        else
            # Fallback: Prometheus metrics
            local r_live=$(uclient-fetch -q -O - --timeout=1 "http://127.0.0.1:${CACHED_METRICS_PORT}/metrics" 2>/dev/null | grep "user=\"${tgt}\"")
            conns=$(echo "$r_live" | awk '/connections_current/{print int($2)}')
            octets=$(echo "$r_live" | awk '/octets_to_client/{s+=$2}/octets_from_client/{s+=$2}END{print int(s)}')
            active_ips=$(echo "$r_live" | awk '/unique_ips_current/{print int($2)}')
            [ -z "$conns" ] && conns=0
            [ -z "$octets" ] && octets=0
            [ -z "$active_ips" ] && active_ips=0
        fi

        # Status line: online/offline/frozen/expired
        local stat_text=""
        if [ "$is_frozen" = "1" ]; then
            stat_text="${E_FRZ} [PAUSED]"
        elif [ "$conns" -gt 0 ] 2>/dev/null; then
            stat_text="${E_OK} ONLINE (${conns} conn)"
        else
            stat_text="${E_OFF} offline"
        fi

        # Expiry check
        local warn_txt=""
        if [ "$e" != "${E_INF}" ]; then
            local exp_epoch=$(date -d "$(echo "$e" | awk -F'[. :]' 'NF==5 {printf "%04d-%02d-%02d %02d:%02d:00", $3,$2,$1,$4,$5}')" +%s 2>/dev/null)
            local now_epoch=$(date +%s)
            if [ -n "$exp_epoch" ] && [ "$now_epoch" -ge "$exp_epoch" ]; then
                stat_text="${E_ERR} [EXPIRED]"
            elif [ -n "$exp_epoch" ]; then
                local diff=$((exp_epoch - now_epoch))
                [ "$diff" -le 259200 ] && warn_txt="\n${E_WARN} Expires in $((diff / 86400))d!"
            fi
        fi

        # IP usage display
        local ip_display="${active_ips}"
        if [ "$max_ips" != "${E_INF}" ] && [ -n "$max_ips" ]; then
            ip_display="${active_ips} / ${max_ips}"
            [ "$active_ips" -ge "$max_ips" ] 2>/dev/null && ip_display="${active_ips} / ${max_ips} ${E_WARN}"
        fi

        local traf=$(fmt_traffic "${octets:-0}")

        if [ -z "$link" ]; then
            local e_ip=$(uci -q get telemt.general.external_ip)
            local e_port=$(uci -q get telemt.general.port || echo "443")
            link="tg://proxy?server=${e_ip}&port=${e_port}&secret=${sec}"
        fi

        local out="${E_PRF} <b>User:</b> ${tgt} ${stat_text}\n${E_KEY} <code>${sec}</code>\n\n${E_STAT} <b>Quota:</b> ${q}\n${E_GLOB} <b>IPs:</b> ${ip_display} (max: ${max_ips})\n${E_CAL} <b>Expires:</b> ${e}${warn_txt}\n\n<b>--- Live Stats ---</b>\n${E_TRAF} Traffic: ${traf}\n${E_PRX} Connections: ${conns}\n${E_GLOB} Active IPs: ${active_ips}\n\n${E_LINK} <code>${link}</code>\n\n<i>Use Apply to hot-reload config.</i>"

        local kb="{\"inline_keyboard\":[[{\"text\":\"${E_EDIT} Rename\",\"callback_data\":\"user_rename_${tgt}\"},{\"text\":\"${E_RGN} Regen Secret\",\"callback_data\":\"user_regen_${tgt}\"}],[{\"text\":\"${E_STAT} Quota\",\"callback_data\":\"user_set_quota_${tgt}\"},{\"text\":\"${E_GLOB} Max IPs\",\"callback_data\":\"user_set_ips_${tgt}\"}],[{\"text\":\"${E_CAL} Expiry\",\"callback_data\":\"user_set_expiry_${tgt}\"},{\"text\":\"${E_DEL} Delete\",\"callback_data\":\"user_delete_confirm_${tgt}\"}],[{\"text\":\"${fr_t}\",\"callback_data\":\"user_freeze_${tgt}\"},{\"text\":\"${E_RST} Apply\",\"callback_data\":\"cmd_apply_stay_user_${tgt}\"}],[{\"text\":\"${E_BACK} Back to Users\",\"callback_data\":\"cmd_users\"}]]}"
        send_message "$out" "$kb"
        ;;

    # ── Quick-set callbacks ──
    user_q_add_*)
        local val="${cmd#user_q_add_}"; local add_amt="${val%%_*}"; local tgt="${val#*_}"
        local cur=$(uci -q get "telemt.${tgt}.data_quota"); [ -z "$cur" ] && cur=0
        local new_q=$(echo "$cur $add_amt" | awk '{print $1+$2}')
        uci_safe set "telemt.${tgt}.data_quota=${new_q}"; uci_safe_commit
        rm -f "$STATE_FILE"; handle_command "user_manage_${tgt}"
        ;;
    user_q_clr_*)
        local tgt="${cmd#user_q_clr_}"
        uci_safe delete "telemt.${tgt}.data_quota"; uci_safe_commit
        rm -f "$STATE_FILE"; handle_command "user_manage_${tgt}"
        ;;

    user_i_set_*)
        local vt="${cmd#user_i_set_}"; local v=$(echo "$vt"|cut -d'_' -f1); local tgt=$(echo "$vt"|cut -d'_' -f2-)
        uci_safe set "telemt.${tgt}.max_unique_ips=${v}"; uci_safe_commit
        rm -f "$STATE_FILE"; handle_command "user_manage_${tgt}"
        ;;
    user_i_clr_*)
        local tgt="${cmd#user_i_clr_}"
        uci_safe delete "telemt.${tgt}.max_unique_ips"; uci_safe_commit
        rm -f "$STATE_FILE"; handle_command "user_manage_${tgt}"
        ;;

    user_exp_add_*)
        local vt="${cmd#user_exp_add_}"; local p=$(echo "$vt"|cut -d'_' -f1); local tgt=$(echo "$vt"|cut -d'_' -f2-)
        local as=0
        [ "$p" = "1d" ] && as=86400; [ "$p" = "1w" ] && as=604800
        [ "$p" = "1m" ] && as=2592000; [ "$p" = "3m" ] && as=7776000
        local ep=$(( $(date +%s) + as ))
        local nd=$(awk -v e="$ep" 'BEGIN{print strftime("%d.%m.%Y %H:%M", e)}' 2>/dev/null)
        [ -z "$nd" ] || echo "$nd" | grep -q "strftime" && nd=$(date -d "@$ep" +"%d.%m.%Y %H:%M" 2>/dev/null)
        uci_safe set "telemt.${tgt}.expire_date=${nd}"; uci_safe_commit
        rm -f "$STATE_FILE"; handle_command "user_manage_${tgt}"
        ;;
    user_exp_clr_*)
        local tgt="${cmd#user_exp_clr_}"
        uci_safe delete "telemt.${tgt}.expire_date"; uci_safe_commit
        rm -f "$STATE_FILE"; handle_command "user_manage_${tgt}"
        ;;

    user_ui_cancel_*)
        local tgt="${cmd#user_ui_cancel_}"
        rm -f "$STATE_FILE"; handle_command "user_manage_${tgt}"
        ;;

    user_set_quota_*)
        local tgt="${cmd#user_set_quota_}"; echo "quota_${tgt}" > "$STATE_FILE"
        local kb="{\"inline_keyboard\":[[{\"text\":\"+ 1 GB\",\"callback_data\":\"user_q_add_1_${tgt}\"},{\"text\":\"+ 5 GB\",\"callback_data\":\"user_q_add_5_${tgt}\"}],[{\"text\":\"${E_INF} Unlimited (Clear)\",\"callback_data\":\"user_q_clr_${tgt}\"}],[{\"text\":\"${E_BACK} Cancel\",\"callback_data\":\"user_ui_cancel_${tgt}\"}]]}"
        send_message "${E_STAT} Choose Quota to ADD for <b>${tgt}</b> or type custom absolute value (GB):" "$kb"
        ;;

    user_set_ips_*)
        local tgt="${cmd#user_set_ips_}"; echo "ips_${tgt}" > "$STATE_FILE"
        local kb="{\"inline_keyboard\":[[{\"text\":\"1 IP\",\"callback_data\":\"user_i_set_1_${tgt}\"},{\"text\":\"2 IPs\",\"callback_data\":\"user_i_set_2_${tgt}\"},{\"text\":\"5 IPs\",\"callback_data\":\"user_i_set_5_${tgt}\"}],[{\"text\":\"${E_INF} Unlimited (Clear)\",\"callback_data\":\"user_i_clr_${tgt}\"}],[{\"text\":\"${E_BACK} Cancel\",\"callback_data\":\"user_ui_cancel_${tgt}\"}]]}"
        send_message "${E_GLOB} Choose Max IPs for <b>${tgt}</b> or type custom:" "$kb"
        ;;

    user_set_expiry_*)
        local tgt="${cmd#user_set_expiry_}"; echo "expiry_${tgt}" > "$STATE_FILE"
        local kb="{\"inline_keyboard\":[[{\"text\":\"+1 Day\",\"callback_data\":\"user_exp_add_1d_${tgt}\"},{\"text\":\"+1 Week\",\"callback_data\":\"user_exp_add_1w_${tgt}\"}],[{\"text\":\"+1 Month\",\"callback_data\":\"user_exp_add_1m_${tgt}\"},{\"text\":\"+3 Months\",\"callback_data\":\"user_exp_add_3m_${tgt}\"}],[{\"text\":\"${E_INF} Clear Expiry\",\"callback_data\":\"user_exp_clr_${tgt}\"}],[{\"text\":\"${E_BACK} Cancel\",\"callback_data\":\"user_ui_cancel_${tgt}\"}]]}"
        send_message "${E_CAL} Choose Expiry to ADD for <b>${tgt}</b> or type (DD.MM.YYYY HH:MM):" "$kb"
        ;;

    user_regen_*)
        local tgt="${cmd#user_regen_}"
        uci_safe set "telemt.${tgt}.secret=$(cat /proc/sys/kernel/random/uuid | tr -d '-' | cut -c 1-32)"
        uci_safe_commit; handle_command "user_manage_${tgt}"
        ;;

    user_rename_*)
        echo "rename_${cmd#user_rename_}" > "$STATE_FILE"
        send_message "${E_EDIT} Enter new name for <b>${cmd#user_rename_}</b>:"
        ;;

    user_freeze_*)
        local tgt="${cmd#user_freeze_}"
        local d=$(uci -q get "telemt.${tgt}.disabled" | awk '{print tolower($1)}')
        if [ "$d" = "1" ] || [ "$d" = "true" ] || [ "$d" = "on" ]; then
            uci_safe set "telemt.${tgt}.disabled=0"
        else
            uci_safe set "telemt.${tgt}.disabled=1"
        fi
        uci_safe_commit; handle_command "user_manage_${tgt}"
        ;;

    user_delete_confirm_*)
        local tgt="${cmd#user_delete_confirm_}"
        local kb="{\"inline_keyboard\":[[{\"text\":\"${E_DEL} YES, DELETE\",\"callback_data\":\"user_delete_do_${tgt}\"}],[{\"text\":\"${E_BACK} CANCEL\",\"callback_data\":\"user_manage_${tgt}\"}]]}"
        send_message "${E_ERR} Are you sure you want to delete <b>${tgt}</b>?" "$kb"
        ;;

    user_delete_do_*)
        uci_safe delete "telemt.${cmd#user_delete_do_}"
        uci_safe_commit; /etc/init.d/telemt restart; handle_command "cmd_users"
        ;;

    cmd_add_user)
        local n="u_$(awk 'BEGIN{srand(); printf "%04x", rand()*65535}')"
        uci_safe set "telemt.${n}=user"
        uci_safe set "telemt.${n}.secret=$(cat /proc/sys/kernel/random/uuid | tr -d '-' | cut -c 1-32)"
        uci_safe_commit; /etc/init.d/telemt restart; handle_command "user_manage_${n}"
        ;;

    *) ;; # Unknown command — ignore silently
    esac
}

# ==============================================================================
# 6. MAIN LOOP
# ==============================================================================

cleanup() {
    logger -t telemt-bot "Shutting down (PID $$)..."
    trap '' INT TERM
    [ -n "$HEALTH_PID" ] && kill "$HEALTH_PID" 2>/dev/null
    # Kill only our direct children, NOT the entire process group
    # (kill 0 can take down procd/uhttpd on OpenWrt)
    local cpid
    for cpid in $(pgrep -P $$ 2>/dev/null); do
        kill "$cpid" 2>/dev/null
    done
    sleep 1
    for cpid in $(pgrep -P $$ 2>/dev/null); do
        kill -KILL "$cpid" 2>/dev/null
    done
    rm -f "$STATE_FILE" "$UCI_LOCK" "$HEALTH_STATE_FILE" "$WAN_IP_FILE"
    exit 0
}
trap cleanup INT TERM

logger -t telemt-bot "Starting v${BOT_VERSION} Long Polling loop..."
update_proxy_cache
cache_versions
refresh_wan_ip
start_health_daemon

while true; do
    response=$(api_poll)
    [ -z "$response" ] && sleep 2 && continue

    i=0
    while true; do
        id=$(echo "$response" | jsonfilter -e "@.result[$i].update_id" 2>/dev/null)
        [ -z "$id" ] && break
        OFFSET=$((id + 1))

        chat_id=$(echo "$response" | jsonfilter -e "@.result[$i].message.chat.id" 2>/dev/null)
        text=$(echo "$response" | jsonfilter -e "@.result[$i].message.text" 2>/dev/null)
        u_name=$(echo "$response" | jsonfilter -e "@.result[$i].message.from.username" 2>/dev/null)
        callback_id=""
        CALLBACK_MSG_ID=""

        if [ -z "$chat_id" ]; then
            chat_id=$(echo "$response" | jsonfilter -e "@.result[$i].callback_query.message.chat.id" 2>/dev/null)
            text=$(echo "$response" | jsonfilter -e "@.result[$i].callback_query.data" 2>/dev/null)
            callback_id=$(echo "$response" | jsonfilter -e "@.result[$i].callback_query.id" 2>/dev/null)
            u_name=$(echo "$response" | jsonfilter -e "@.result[$i].callback_query.from.username" 2>/dev/null)
            CALLBACK_MSG_ID=$(echo "$response" | jsonfilter -e "@.result[$i].callback_query.message.message_id" 2>/dev/null)
        fi

        [ -n "$u_name" ] && u_name="@${u_name}" || u_name="Unknown User"

        if [ "$chat_id" = "$ADMIN_ID" ] && [ -n "$text" ]; then
            if [ -f "$STATE_FILE" ]; then
                logger -t telemt-bot "Audit: ${u_name} (ID: ${chat_id}) -> Interactive Input"
            else
                logger -t telemt-bot "Audit: ${u_name} (ID: ${chat_id}) -> Cmd: ${text}"
            fi
            handle_command "$text"
            update_proxy_cache
            if [ -n "$callback_id" ]; then
                api_request "answerCallbackQuery" "{\"callback_query_id\":\"${callback_id}\"}" >/dev/null
            fi
        elif [ -n "$chat_id" ] && [ -n "$text" ]; then
            logger -t telemt-bot "SECURITY WARNING: Unauthorized access from ${u_name} (ID: ${chat_id}) -> Cmd: ${text}"
        fi

        i=$((i + 1))
    done
done
