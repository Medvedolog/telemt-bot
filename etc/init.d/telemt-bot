#!/bin/sh /etc/rc.common
# ==============================================================================
# Telemt-Bot — procd service definition v.3.3.30
# Sidecar Telegram bot for telemt MTProxy management
#
# Requires: /etc/config/telemt with [general] section containing
#   bot_enabled, bot_token, bot_chat_id
# The postinst script creates a minimal UCI skeleton if missing.
#
# NOTE: No procd_add_reload_trigger here — the bot must NOT restart
# when the main telemt config changes (uci commit telemt). The bot
# survives proxy restarts and reports them to the admin. Restart the
# bot manually only when bot_token or bot_chat_id changes.
# ==============================================================================

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/telemt-bot
CONF=telemt

start_service() {
    # Guard: UCI config must exist
    if [ ! -f "/etc/config/$CONF" ]; then
        logger -t telemt-bot "Error: /etc/config/$CONF not found."
        return 1
    fi

    local enabled
    config_load "$CONF"
    config_get enabled general bot_enabled "0"

    [ "$enabled" = "1" ] || {
        logger -t telemt-bot "Service disabled in UCI (bot_enabled=0). Not starting."
        return 0
    }

    local token chat_id
    config_get token general bot_token ""
    config_get chat_id general bot_chat_id ""

    [ -n "$token" ] && [ -n "$chat_id" ] || {
        logger -t telemt-bot "Error: bot_token or bot_chat_id not configured."
        return 1
    }

    procd_open_instance "telemt-bot"
    procd_set_param command "$PROG"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance

    logger -t telemt-bot "Service started (chat_id=${chat_id})."
}

stop_service() {
    logger -t telemt-bot "Service stopping..."
    local p
    for p in $(pgrep -f "$PROG" 2>/dev/null); do
        kill -TERM "$p" 2>/dev/null
    done
    sleep 2
    for p in $(pgrep -f "$PROG" 2>/dev/null); do
        kill -KILL "$p" 2>/dev/null
    done
    rm -f /tmp/telemt_bot_state /tmp/telemt_health_state /tmp/telemt_uci.lock
}
